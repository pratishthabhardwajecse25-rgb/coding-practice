#include <stdio.h>

int linearSearch(int arr[], int n, int key){
    for(int i = 0; i < n; i++){
        if(arr[i] == key){
            return i;
        }
    }
    return -1;
}

int main()
{
    int arr[] = {12, 56, 23, 78, 89};
    int n = sizeof(arr) / sizeof(arr[0]);
    int key = 34;
    printf("The index of element is: %d", linearSearch(arr, n, key));
    return 0;
}
