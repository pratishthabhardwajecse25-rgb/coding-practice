#include<stdio.h>
#include<stdlib.h>
struct Node{
    int data;
    struct Node *next;
    struct Node *prev;
};
int main(){
    struct Node n1;
    n1.data=4;
    n1.next=NULL;
    n1.prev=NULL;
    printf("NULL<->%d",n1.data);
    printf("<->NULL");
}
OUTPUT-NULL<->4<->NULL
#include<stdio.h>
#include<stdlib.h>
struct Node{
