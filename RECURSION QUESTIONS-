9-PRINT SUM OF DIGITS FOR A NUMBER(USING RECURSION)-
#include<stdio.h> //ques 9         
int sumdigit(int n){
    if(n==0) //base case
        return 0;
    return (n%10)+sumdigit(n/10); //recursive call and sumdigit formula
}
int main(){
    int n;
    printf("enter the value of n:");
    scanf("%d",&n);
    printf("sum=%d",sumdigit(n)); //function call 
}
