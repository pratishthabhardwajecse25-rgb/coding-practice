1-PRINT NUMBERS FROM 1 TO N(USING RECURSION)-
#include<stdio.h> //ques 1
void num(int n){
    if(n==0) //base case
        return;
    num(n-1); //recursive call
    printf("%d",n);
}
int main(){
    int n;
    printf("enter the value of n:");
    scanf("%d",&n);
    num(n);
}
