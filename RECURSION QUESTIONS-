3-FACTORIAL OF N(USING RECURSION)-
#include<stdio.h> //ques 3
int fact(int n){
    if(n==0 || n==1) //base case
        return 1;
    return n*fact(n-1); //recursive call and fact formula
}
int main(){
    int n;
    printf("enter the value of n:");
    scanf("%d",&n);
    printf("factorial=%d",fact(n));
}
