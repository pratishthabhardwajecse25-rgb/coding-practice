8-CALCULATE X RAISED TO THE POWER OF N-
#include<stdio.h>        //ques-8
int power(int x,int n){
    if(n==0)              //base case
       return 1;
    return x*power(x,n-1);    //recursive call and formula
}
int main(){
    int x,n;
    printf("enter value of x and value n:");
    scanf("%d %d",&x,&n);
    printf("power=%d",power(x,n));
}
