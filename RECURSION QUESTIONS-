4-PRINT THE FABONACCI SEQUENCE(USING RECURSION)-
#include<stdio.h> //ques 4
int fab(int n){
//LOGIC-
//fab(0)=0
//fab(1)=1
//fab(2)=fab(1)+fab(0)=1
//fab(3)=fab(2)+fab(1)=2
    if(n==0) //base case
        return 0;
    if(n==1)
        return 1; //base case
    return fab(n-1)+fab(n-2); //recursive call and fab formula
}
int main(){
    int n,i;
    printf("enter the value of n:");
    scanf("%d",&n);
    for(i=0;i<n;i++){
        printf("%d",fab(i)); //function call
    }
}
