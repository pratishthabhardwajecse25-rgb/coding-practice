10-REVERSE A STRING(USING RECURSION)-
#include<stdio.h> //ques 10         
void rev(char str[],int i){
    if(str[i]=='\0') //base case
        return;
    rev(str,i+1); //recursive call and sumdigit formula
    printf("%c",str[i]);
}
int main(){
    char str[100];
    printf("enter the string:");
    scanf("%s",&str);
    rev(str,0);
}
