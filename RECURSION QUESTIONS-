7-CALCULATE THE SUM FROM 1 TO N-
#include<stdio.h>  //ques-7
//sum(0) = 0
//sum(1) = 1 + 0 = 1
//sum(2) = 2 + 1 = 3
//sum(3) = 3 + 3 = 6
//sum(4) = 4 + 6 = 10
int sum(int n){
    if(n==0)              //base case
       return 0;
    return n+sum(n-1);    //recursive call and formula
}
int main(){
    int n;
    printf("enter value of n:");
    scanf("%d",&n);
    printf("sum=%d",sum(n));
}
