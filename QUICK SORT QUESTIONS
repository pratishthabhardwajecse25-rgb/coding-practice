2-Write a C program for Quick Sort in which the partitioning logic is in its own function int
partition(int arr[], int low, int high). The quickSort() function must call it. Print
the array before and after sorting.
#include<stdio.h>
int partition(int arr[],int low,int high){
    int pivot=arr[high];
    int i=low-1;
    for(int j=low;j<high;j++){
        if(arr[j]<pivot){
            i++;
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
        }
    }
    int temp=arr[i+1];
    arr[i+1]=arr[high];
    arr[high]=temp;
    return i+1;
}
void quickSort(int arr[],int low,int high){
    if(low>=high)
        return;
    int p=partition(arr,low,high);
    quickSort(arr,low,p-1);
    quickSort(arr,p+1,high);
}
int main(){
    int arr[5]={5,2,8,1,3};
    printf("Before sorting: ");
    for(int i=0;i<5;i++)
        printf("%d ",arr[i]);
    quickSort(arr,0,4);
    printf("\nAfter sorting: ");
    for(int i=0;i<5;i++)
        printf("%d ",arr[i]);
}
