1-Write a C program that sorts the array {45, 12, 89, 33, 7, 56} using Quick Sort. After every
partition, print the pivot value, the pivot's final index, and the current state of the array.
#include<stdio.h>
void Quicksort(int arr[],int start,int end){
    if(start>=end)
        return;
    int pivot=arr[end];
    int i=start-1;
    for(int j=start;j<end;j++){
        if(arr[j]<pivot){
            i++;
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
        }
    }
    int temp=arr[i+1];
    arr[i+1]=arr[end];
    arr[end]=temp;
    int p1=i+1;
    printf("pivot=%d,index=%d\n",pivot,p1);
    for(int k=0;k<6;k++){
        printf("%d ",arr[k]);
    }
    printf("\n");
    Quicksort(arr,start,p1-1);
    Quicksort(arr,p1+1,end);
}
int main(){
    int arr[6]={45,12,89,33,7,56};
    Quicksort(arr,0,5);
    printf("Sort:");
    for(int i=0;i<6;i++){
        printf("%d ",arr[i]);
    }
}
