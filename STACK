ques-. Postfix Evaluation
Write a C program that evaluates a postfix expression such as 5 3 2 * + 4 - using a stack.
Support the operators +, -, *, / and single-digit operands.
#include <stdio.h>
int arr[100];
int top=-1;
void push(int x){
    top++;
    arr[top]=x;
}
int pop(){
    int value=arr[top];
    top--;
    return value;
}
int main(){
    char s[]="532*+4-";
    for (int i=0;s[i]!='\0';i++) {
        if (s[i]>='0'&& s[i]<= '9') {
            push(s[i]-'0');
        }
        else {           //a=3 b=2
            int b=pop();
            int a=pop();
            if (s[i]=='+')
                push(a+b);
            else if (s[i]=='-')
                push(a-b);
            else if (s[i]=='*')
                push(a*b);
            else if (s[i]=='/')
                push(a/b);
        }
    }
    printf("%d",pop());
    return 0;
}
