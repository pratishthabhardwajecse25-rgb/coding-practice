#include <stdio.h>
int size = 5;
int top = -1;
int arr[5];
void push(int x){
    if(top==size-1){
        printf("Stack overflow");
        return;
    }
    top++;
    arr[top]=x;
}
int pop(){
    if(top==-1){
        printf("Stack overflow");
        return -1;
    }
    int value=arr[top];
    top--;
    return value;
}
int peek(){
    if(top==-1){
        return -1;
    }
    return arr[top];
}
int isSize(){
    return top+1;
}
int main() {
    push(10);
    push(20);
    printf("Popped: %d\n", pop());
    printf("Top element: %d\n", peek());
    printf("Stack size: %d\n", isSize());
}
