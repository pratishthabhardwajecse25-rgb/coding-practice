int size;
int top=-1;
int arr[100];
void push(int x){
    if(top==size-1){
        printf("stack overflow");
        return;
    }
    top++;
    arr[top]=x;
}
int main(){
    int x;
    printf("enter size");
    scanf("%d",&size);                      //agr hum loop lagadenge toh kaafi saare elements rkh skte h
    printf("enter element");
    scanf("%d",&x);
    push(x);
    printf("%d",arr[top]);
}
