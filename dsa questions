int missingNumber(int nums[], int numsSize) {
    int s=0;
    for (int i=0; i<numsSize; i++) {
        s=s+nums[i];
    }
    int n=numsSize;
    int tl=n*(n+1)/2;
    return tl-s;
}
int main() {
    int nums[100],n;
    printf("size:");
    scanf("%d", &n);
    printf("elements:");
    for (int i=0; i<n; i++) {
        scanf("%d", &nums[i]);
    }
    printf("missing= %d", missingNumber(nums, n));
    return 0;
} //missing= 2

