#include<stdbool.h>
bool isAnagram(char s[], char t[]){
    int i,j,c;
    for(i=0; s[i]!='\0'; i++){
        c=0;
        for(j=0; s[j]!='\0'; j++){
            if(s[i]==s[j])
                c++;
        }
        for(j=0; t[j]!='\0'; j++){
            if(s[i]==t[j])
                c--;
        }
        if(c!=0){
            return false;
        }
    }
    return true;
}
int main() {
    char s[1000],t[1000];
    printf("first string:");
    scanf("%s",s);
    printf("second string:");
    scanf("%s",t);
    if(isAnagram(s,t))
        printf("true");
    else
        printf("false");
    return 0;
}
