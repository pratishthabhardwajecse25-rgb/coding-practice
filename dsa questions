int mySqrt(int x) {
    int l=1, h=x;
    int a=0;
    if (x == 0)
        return 0;
    while (l <= h) {
        int m=(l+h)/2;

        if (m<=x/m) {
            a=m;
            l=m+1;
        }
        else {
            h=m-1;
        }
    }
    return a;
}
int main() {
    int x;
    printf("x:");
    scanf("%d", &x);
    printf("sqaure root=%d", mySqrt(x));
    return 0;
}//output=sqaure root=9
