void insertBeginning(struct Node **head, int val){
    struct Node *newNode = malloc(sizeof(struct Node));
    if(newNode == NULL){
        printf("cant insert\n");
        return;
    }
    newNode->data = val;
    newNode->next = *head;
    *head = newNode;
}
void insertmiddle(struct Node **head, int val, int pos){
    struct Node *newNode=malloc(sizeof(struct Node));
    if(newNode==NULL){
        printf("cant insert\n");
        return;
    }
    newNode->data = val;
    struct Node *temp = *head;
    //node before/after the position
    for(int i=1; i<pos-1;i++){
        temp=temp->next;
    }
    newNode->next=temp->next;
    temp->next=newNode;
}
