    struct Node n1,n2,n3,n4;
    n1.data=4;
    n2.data=6;
    n3.data=9;
    n4.data=12;
    n1.next=NULL;
    printf("%d->",n2.data);
    printf("%d-",n3.data);
    printf("%d-",n4.data);
    printf("%d->",n1.data);
