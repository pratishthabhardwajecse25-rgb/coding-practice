  struct  Node *head=NULL;
    insertElement(&head,10);
    insertElement(&head,20);
    insertElement(&head,30);
    insertElement(&head,40);
    insertBeginning(&head,13);
    insertmiddle(&head,70,4);
    printlist(head);
}
