Q4. Product of Digits
Write a recursive C program to calculate the product of all digits of a number.
#include<stdio.h>
int product(int n)
{
    if(n==0)
        return 1;
    return (n%10)*product(n/10);
}
int main()
{
    int n,result;
    scanf("%d",&n);
    result=product(n);
    printf("%d",result);
    return 0;
}
