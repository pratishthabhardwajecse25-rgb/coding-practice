Q5. Find Maximum Digit
Write a recursive C program to find the maximum digit in a given number.
#include<stdio.h>
int max(int n){
    if(n<10)
        return n;
    int digit=n%10;
    int m=max(n/10);
    if(digit>m)
        return digit;
    else
        return m;
}
int main()
{
    int n,result;
    scanf("%d",&n);
    result=max(n);
    printf("%d",result);
    return 0;
}
