#include<stdio.h>
int main(){
    char greetings[]="hello world";
    printf("%s",greetings);
}
#include<stdio.h>
int main(){
    char greetings[]="hello world";
    printf("%c",greetings[0]);
}
#include<stdio.h>
int main(){
    char carName[]="Toyota";
    int i;
    for(i=0;i<6;i++){
        printf("%c\n",carName[i]);
    }
}
#include<stdio.h>
int main(){
    char carName[]="Toyota";
    int length=sizeof(carName)/sizeof(carName[0]);
    int i;
    for(i=0;i<length;++i){
        printf("%c\n",carName[i]);
    }
}
