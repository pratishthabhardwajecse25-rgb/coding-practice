to rotate array with k value:
#include <stdio.h>
int main(){
    int a[10],n,k,temp;
    printf("Enter size: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(int i=0; i<n; i++){
        scanf("%d",&a[i]);
    }
    printf("Enter k: ");
    scanf("%d",&k);
    k=k%n;
    for(int j=0;j<k;j++){
        temp=a[0];
        for(int i=0;i<n-1;i++){
            a[i]=a[i+1];
        }
        a[n-1]=temp;
    }
    printf("Rotated array: ");
    for(int i=0;i<n;i++) {
        printf("%d ",a[i]);
    }
}
