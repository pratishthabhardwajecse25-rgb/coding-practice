AVERAGE CASE TIME COMPLEXITY-O(nlogn) and WORST CASE-O(n^2)
#include <stdio.h>
void Quicksort(int arr[],int start,int end){ //pivot element=end
    if(start>=end){
        return;
    }
    int pivot=arr[end];
    int i=start-1;
    for(int j=start;j<end;j++){
        
        if(arr[j]<pivot){
             i++;    
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
        }
    }
    int temp=arr[i+1];
    arr[i+1]=arr[end];      //swap
    arr[end]=temp;
    int p1=i+1;
    Quicksort(arr,start,p1-1);
    Quicksort(arr,p1+1,end);
}
int main(){
    int arr[5]={5,2,8,1,3};
    Quicksort(arr,0,4);
    for(int i=0;i<5;i++){
        printf("%d ",arr[i]);
    }
    return 0;
}




