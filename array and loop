#include <stdio.h>
int main(){
    int n,i;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter elements of array:\n");
    for(i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }
    int m = arr[0];
    int mi = arr[0];
    for(i = 1; i < n; i++){
        if(arr[i] > m)
            m = arr[i];
        if(arr[i] < mi)
            mi= arr[i];
    }
    printf("Maximum = %d\n", m);
printf("Minimum = %d\n", mi);
}
