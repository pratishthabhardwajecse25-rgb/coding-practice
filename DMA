1. malloc()
#include <stdio.h>
#include <stdlib.h>
int main(){
    int *p;
    p = (int*)malloc(5 * sizeof(int));
    printf("Enter 5 numbers:\n");
    for(int i = 0; i < 5; i++)
        scanf("%d", &p[i]);
    printf("Array: ");
    for(int i = 0; i < 5; i++)
        printf("%d ", p[i]);
    free(p);
    return 0;
}
2. calloc()
#include <stdio.h>
#include <stdlib.h>
int main()
{    int *p;
    p = (int*)calloc(5, sizeof(int));
    printf("Array: ");
    for(int i = 0; i < 5; i++)
        printf("%d ", p[i]);
    free(p);
    return 0;
}
Output:
Array: 0 0 0 0 0
3. realloc()
#include <stdio.h>
#include <stdlib.h>
int main(){
    int *p;
    p = (int*)malloc(2 * sizeof(int));
    p[0] = 10;
    p[1] = 20;
    p = (int*)realloc(p, 4 * sizeof(int));
    p[2] = 30;
    p[3] = 40;
    for(int i = 0; i < 4; i++)
        printf("%d ", p[i]);
    free(p);
    return 0;
}
Output:
10 20 30 40
